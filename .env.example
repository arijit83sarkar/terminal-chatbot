# Copy to .env (never commit .env) and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional - the code has defaults for these.
CHATBOT_MODEL=claude-sonnet-5-5
CHATBOT_MAX_TOKENS=1024

# Leave CHATBOT_TEMPERATURE unset for claude-sonnet-5-5: it only accepts the default
# temperature, so any other value makes ChatAnthropic raise a ValueError (see exercise 08).
# CHATBOT_TEMPERATURE=1.0
